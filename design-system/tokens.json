{
  "version": "1.0.0",
  "name": "Twilio Design System",
  "description": "Design tokens for Twilio-inspired design system",
  "colors": {
    "primary": {
      "base": "#0263E0",
      "hover": "#014DB5",
      "light": "#F0F6FF",
      "description": "Main brand color for buttons, links, and active states"
    },
    "success": {
      "base": "#10B981",
      "light": "#ECFDF5",
      "dark": "#047857",
      "description": "Success states, active status, confirmations"
    },
    "warning": {
      "base": "#F59E0B",
      "light": "#FFFBEB",
      "dark": "#B45309",
      "description": "Warnings, alerts, requires attention"
    },
    "error": {
      "base": "#EF4444",
      "light": "#FEF2F2",
      "dark": "#B91C1C",
      "description": "Errors, destructive actions, failures"
    },
    "neutral": {
      "50": "#F9FAFB",
      "100": "#F3F4F6",
      "200": "#E5E7EB",
      "300": "#D1D5DB",
      "400": "#9CA3AF",
      "500": "#6B7280",
      "600": "#4B5563",
      "700": "#374151",
      "800": "#1F2937",
      "900": "#111827",
      "description": "Gray scale for backgrounds, borders, and text"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": ["Inter", "system-ui", "sans-serif"],
      "mono": ["Monaco", "Courier New", "monospace"]
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "fontWeight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "lineHeight": {
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.75
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem"
  },
  "borderRadius": {
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1)",
    "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1)"
  },
  "components": {
    "button": {
      "primary": {
        "background": "#0263E0",
        "backgroundHover": "#014DB5",
        "text": "#FFFFFF",
        "borderRadius": "0.5rem",
        "padding": "0.625rem 1.5rem",
        "fontSize": "0.875rem",
        "fontWeight": 600
      },
      "secondary": {
        "background": "#FFFFFF",
        "backgroundHover": "#F9FAFB",
        "text": "#374151",
        "border": "1px solid #D1D5DB",
        "borderRadius": "0.5rem",
        "padding": "0.625rem 1.5rem",
        "fontSize": "0.875rem",
        "fontWeight": 600
      },
      "destructive": {
        "background": "#FFFFFF",
        "backgroundHover": "#FEF2F2",
        "text": "#EF4444",
        "border": "1px solid #FEE2E2",
        "borderRadius": "0.5rem",
        "padding": "0.625rem 1.5rem",
        "fontSize": "0.875rem",
        "fontWeight": 600
      }
    },
    "badge": {
      "success": {
        "background": "#ECFDF5",
        "text": "#047857",
        "border": "1px solid #D1FAE5"
      },
      "warning": {
        "background": "#FFFBEB",
        "text": "#B45309",
        "border": "1px solid #FEF3C7"
      },
      "error": {
        "background": "#FEF2F2",
        "text": "#B91C1C",
        "border": "1px solid #FEE2E2"
      },
      "neutral": {
        "background": "#F3F4F6",
        "text": "#6B7280",
        "border": "1px solid #E5E7EB"
      }
    },
    "input": {
      "background": "#FFFFFF",
      "border": "1px solid #D1D5DB",
      "borderRadius": "0.5rem",
      "padding": "0.625rem 0.75rem",
      "fontSize": "0.875rem",
      "focusBorder": "#0263E0",
      "focusRing": "0 0 0 3px rgba(2, 99, 224, 0.1)"
    },
    "table": {
      "headerBackground": "#F9FAFB",
      "headerText": "#6B7280",
      "border": "#E5E7EB",
      "rowHover": "#F9FAFB",
      "cellPadding": "0.75rem 1rem"
    }
  }
}
